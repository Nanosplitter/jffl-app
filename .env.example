VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Use only for local development with Firebase emulators.
VITE_USE_EMULATORS=false

# "Ask the archive" assistant (Firebase AI Logic). The reCAPTCHA Enterprise site key is public client
# configuration; it is required in production builds so App Check can protect the model.
VITE_RECAPTCHA_SITE_KEY=
# Optional: a separate Firebase project (and web app) that hosts Firebase AI Logic, App Check, and Remote Config
# for the assistant, so Gemini billing and quotas live there. Leave empty to use the main project above.
# The reCAPTCHA key above must belong to this AI project when these are set.
VITE_AI_FIREBASE_API_KEY=
VITE_AI_FIREBASE_AUTH_DOMAIN=
VITE_AI_FIREBASE_PROJECT_ID=
VITE_AI_FIREBASE_APP_ID=
# Development only: use the canned local assistant instead of Gemini, even when Firebase is configured.
VITE_ASK_MOCK=false
# Development only: a debug token registered in the Firebase console (App Check > Apps > Manage debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=
